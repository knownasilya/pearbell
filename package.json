{
  "name": "pearbell",
  "version": "0.12.0",
  "description": "Peer-to-peer push messages between a CLI and your Android phone, built on the Pear stack. An ntfy.sh alternative for AI tools.",
  "keywords": [
    "pear",
    "holepunch",
    "hyperdht",
    "p2p",
    "push",
    "notifications",
    "ntfy",
    "android",
    "cli",
    "ai-agents",
    "claude-code"
  ],
  "homepage": "https://github.com/knownasilya/pearbell#readme",
  "bugs": {
    "url": "https://github.com/knownasilya/pearbell/issues"
  },
  "type": "module",
  "bin": {
    "pearbell": "cli/bin.js"
  },
  "scripts": {
    "test": "brittle-node test/*.test.js",
    "fake-phone": "node test/fake-phone.js",
    "android:fetch-bare-kit": "scripts/fetch-bare-kit.sh",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:install": "cd android && ./gradlew installDebug",
    "mac:build": "macos/scripts/build-app.sh",
    "mac:run": "macos/scripts/build-app.sh && open macos/build/pearbell.app",
    "prepublishOnly": "npm test"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "b4a": "^1.9.0",
    "hypercore-crypto": "^3.7.0",
    "hyperdht": "^6.34.1",
    "qrcode-terminal": "^0.12.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "bare-fs": "^4.8.4",
    "bare-link": "^4.0.1",
    "bare-pack": "^3.0.2",
    "bare-path": "^3.1.2",
    "brittle": "^4.5.0",
    "release-plan": "^0.18.0"
  },
  "files": [
    "cli",
    "shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knownasilya/pearbell.git"
  },
  "release-plan": {
    "semverIncrementAs": {
      "major": "minor"
    }
  }
}
